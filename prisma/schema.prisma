generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  projectType  String?
  idea         String?
  style        String?
  onboarded    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]
  savedTemplates SavedTemplate[]
  snippets     HtmlSnippet[]
}

model Project {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         String           @default("other")
  status       String           @default("draft")
  schemaJson   String
  analysisJson String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  versions     ProjectVersion[]
}

model ProjectVersion {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number    Int
  label     String
  schemaJson String
  createdAt DateTime @default(now())

  @@index([projectId, number])
}

/// قوالب يحفظها المستخدم من مشاريعه لإعادة استعمالها
model SavedTemplate {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  description     String   @default("")
  icon            String   @default("layers")
  type            String   @default("other")
  schemaJson      String
  sourceProjectId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

/// مكتبة HTML — أكواد يرفعها/يلصقها المستخدم لصفحات هبوط أو لوحات تحكم
model HtmlSnippet {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  kind      String   @default("section")
  html      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
